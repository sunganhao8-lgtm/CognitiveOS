        memoryTitle: "工作记忆",
        memoryEmpty: "点击认知地图上的分区，查看对应工作记忆。",
        masterSays: "主人反复强调的",
        painsTitle: "这些痛点，你经历过吗？",
        pain1Title: "想换个 AI Agent，却不敢换",
        pain1Body: "换新的 = 全部重来。你被\"记忆锁定\"在旧 Agent 上了。",
        pain2Title: "换台电脑，等于失忆",
        pain2Body: "新电脑的 Agent 不认识你。换电脑 = 失忆，从头再来。",
        pain3Title: "Agent 的记忆是\"它的\"，不是\"你的\"",
        pain3Body: "不用它了，积累就没了——换了管家，管家记得的事不是主人的事。",
        painsAnswer: "CognitiveOS 的答案：把\"你的认知\"从 Agent 里拿出来，放到你自己手里。",
        aboutTitle: "如果 AI 是硅基生命，它也需要一个「大脑结构」吗？",
        aboutLead: "主人认知哲学的原始文本（来自 ChatGPT 会话，2026-08-10 整理）",
        aboutP1: "我不是 AI 行业的研究人员，只是一个普通的 AI 使用者。但在每天和 AI 交流、使用 Agent 的过程中，我发现一个很有意思的问题：现在的 AI 越来越聪明，但它好像还不像「人」。",
        aboutH1: "🧠 人类的大脑，本身并不是一个简单的大模型",
        aboutP2: "我们的大脑有不同的区域，它更像一个由很多「专业 Agent」组成的系统：",
        aboutHippo: "负责记忆形成", aboutPrefrontal: "负责规划、决策", aboutCerebellum: "负责动作控制", aboutLanguage: "负责语言处理",
        aboutH2: "而现在很多 AI Agent 是什么？",
        aboutHuman: "真正的人类智能", aboutHumanBody: "不只是记住，而是知道什么时候调用什么记忆。大脑自动判断：「这个问题，应该调用哪一部分经验？」",
        aboutAI: "现在的 AI Agent", aboutAIBody: "一个大模型 + 一个知识库 + 一个记忆数据库 + 一些工具调用能力。像一个超级聪明的人，把所有东西都塞进一个房间。",
        aboutH3: "📊 报表开发者的例子",
        aboutP3: "遇到 Oracle 问题，我会想到数据库经验；遇到报表需求，我会想到以前设计报表的逻辑；遇到性能问题，我会想到 SQL 优化经验。",
        aboutP4: "但现在很多 AI Agent 的 Memory：所有聊天记录 → 一个 Memory 库 → 全部检索。结果就是：记住了，但是不会分类；有信息，但是不知道什么时候调用；知道过去，但是无法形成经验体系。",
        aboutH4: "🚀 下一代 AI，也许不会只是继续扩大参数量",
        aboutP5: "而是会越来越像人脑：拥有不同功能模块，不同 Agent 之间协作，就像人脑不同区域之间交流。",
        aboutWork: "负责职业技能、项目经验、行业知识",
        aboutCreative: "负责灵感、想法、内容创作",
        aboutLearn: "负责知识积累和成长路线",
        aboutMem: "负责整理人生经历，形成长期经验",
        aboutP6: "也许未来真正强大的 AI，不是一个「知道所有事情」的模型，而是一个「知道自己应该什么时候调用什么能力」的智能系统。",
        aboutH5: "📖 系列预告：《如果 AI 想成为数字生命，它还缺少什么？》",
        series1: "AI 为什么需要「海马体」（长期记忆）",
        series2: "AI 为什么需要「前额叶」（目标规划）",
        series3: "AI 为什么需要「人格系统」（价值判断）",
        series4: "AI 为什么需要「睡眠」（整理经验）",
        series5: "AI 为什么需要「遗忘」（避免记忆污染）",
      },
    };

    let lang = (navigator.language || 'en').toLowerCase().startsWith('zh') ? 'zh' : 'en';
    let activeKey = null;
    let activeTab = 'dash';

    function t(k) { return (I18N[lang] && I18N[lang][k]) || I18N.en[k] || k; }

    function setLang(next) {
      lang = next;
      document.documentElement.lang = next === 'zh' ? 'zh-CN' : 'en';
      document.getElementById('lang-en').classList.toggle('active', next === 'en');
      document.getElementById('lang-zh').classList.toggle('active', next === 'zh');
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const k = el.getAttribute('data-i18n');
        if (I18N[lang][k] !== undefined) el.textContent = t(k);
      });
      document.querySelectorAll('.callout').forEach(g => {
        const r = REGIONS.find(x => x.key === g.dataset.region);
        if (!r) return;
        const zh = next === 'zh';
        g.querySelectorAll('.lbl')[0].setAttribute('display', zh ? 'none' : 'inline');
        g.querySelectorAll('.lbl')[1].setAttribute('display', zh ? 'inline' : 'none');
      });
      if (activeKey) renderMemory(activeKey);
    }

    function switchTab(tab) {
      activeTab = tab;
      document.getElementById('tab-dash').classList.toggle('active', tab === 'dash');
      document.getElementById('tab-about').classList.toggle('active', tab === 'about');
      document.getElementById('view-dash').style.display = tab === 'dash' ? '' : 'none';
      document.getElementById('view-about').classList.toggle('shown', tab === 'about');
    }

    function renderMemory(key) {
      const r = REGIONS.find(x => x.key === key);
      if (!r) return;
      activeKey = key;
      const brain = lang === 'zh' ? r.brain_zh : r.brain_en;
      const sys = lang === 'zh' ? r.label_zh : r.label_en;
      const desc = lang === 'zh' ? r.desc_zh : r.desc_en;
      const memItems = r.memory.map(m => {
        const title = lang === 'zh' ? m.title_zh : m.title_en;
        const link = m.path ? `<a href="./${m.path}">${m.path}</a>` : '';
        return `<li>${title}${link}</li>`;
      }).join('');
      const el = document.getElementById('memory-body');
      el.innerHTML = `
        <div class="wm-head">
          <span class="brain">${brain}</span>
          <span class="sys">${sys}</span>
        </div>
        <p class="desc">${desc}</p>
        <h4>${t('masterSays')}</h4>
        <ul class="memory-list">${memItems}</ul>
      `;
      el.classList.add('shown');
      document.getElementById('memory-empty').style.display = 'none';
      document.querySelectorAll('.callout').forEach(g => g.classList.toggle('selected', g.dataset.region === key));
    }

    function closeMemory() {
      activeKey = null;
      document.getElementById('memory-body').classList.remove('shown');
      document.getElementById('memory-body').innerHTML = '';
      document.getElementById('memory-empty').style.display = '';
      document.querySelectorAll('.callout').forEach(g => g.classList.remove('selected'));
    }

    document.querySelectorAll('.callout').forEach(g => {
      const fire = () => renderMemory(g.dataset.region);
      g.addEventListener('click', fire);
      g.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fire(); }
      });
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
    });

    if (lang === 'zh') setLang('zh');
  </script>
</body>
</html>