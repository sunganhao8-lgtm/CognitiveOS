<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CognitiveOS Dashboard</title>
  <style>
    :root {
      --bg: #0f1115;
      --panel: #161922;
      --panel-2: #1d2230;
      --border: #2a3142;
      --text: #e6e8ee;
      --muted: #8b91a3;
      --accent: #6aa9ff;
      --accent-2: #b78cff;
      --good: #4ade80;
      --warn: #fbbf24;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }
    header {
      padding: 28px 36px;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(135deg, var(--panel), var(--panel-2));
    }
    header h1 { margin: 0 0 6px; font-size: 22px; letter-spacing: 0.2px; }
    header p  { margin: 0; color: var(--muted); font-size: 13px; }
    main { padding: 24px 36px 60px; display: grid; gap: 20px; }
    .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 18px;
    }
    .card h2 {
      margin: 0 0 10px;
      font-size: 14px;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      color: var(--muted);
    }
    .stat { font-size: 30px; font-weight: 600; }
    .stat small { display: block; font-size: 12px; color: var(--muted); font-weight: 400; margin-top: 4px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-weight: 500; }
    code {
      font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", monospace;
      background: var(--panel-2);
      padding: 1px 6px;
      border-radius: 4px;
      font-size: 12px;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; }
    .pill.ok { background: rgba(74, 222, 128, 0.15); color: var(--good); }
    .pill.empty { background: rgba(251, 191, 36, 0.15); color: var(--warn); }
    footer { color: var(--muted); font-size: 12px; padding: 12px 36px; border-top: 1px solid var(--border); }
  </style>
</head>
<body>
  <header>
    <h1>CognitiveOS <span style="color: var(--accent)">Dashboard</span></h1>
    <p>Local cognitive runtime · knowledge root: <code>{{ knowledge_root }}</code></p>
  </header>
  <main>
    <section class="grid">
      <div class="card">
        <h2>Agents</h2>
        <div class="stat">{{ agents | length }} <small>discovered on this machine</small></div>
      </div>
      <div class="card">
        <h2>Files harvested</h2>
        <div class="stat">
          {{ agents | sum(attribute='file_count') }}
          <small>copied into knowledge/sources/</small>
        </div>
      </div>
      <div class="card">
        <h2>Wiki pages</h2>
        <div class="stat">{{ wiki_pages | length }} <small>under knowledge/wiki/</small></div>
      </div>
      <div class="card">
        <h2>Bootstrap</h2>
        <div class="stat">
          <span class="pill {{ 'ok' if agents else 'empty' }}">
            {{ 'available' if agents else 'no agents found' }}
          </span>
          <small>generated {{ dashboard_generated_at }}</small>
        </div>
      </div>
    </section>

    <section class="card">
      <h2>Agents in this run</h2>
      {% if agents %}
      <table>
        <thead>
          <tr><th>Agent</th><th>Files</th><th>Source paths</th></tr>
        </thead>
        <tbody>
          {% for a in agents %}
          <tr>
            <td><code>{{ a.agent_id }}</code></td>
            <td>{{ a.file_count }}</td>
            <td>
              {% for f in a.files[:5] %}<code>{{ f }}</code>{% if not loop.last %} · {% endif %}{% endfor %}
              {% if a.files | length > 5 %}<small> · +{{ a.files | length - 5 }} more</small>{% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p>No agents were discovered. Install one (e.g. Hermes) and re-run <code>cogos bootstrap</code>.</p>
      {% endif %}
    </section>

    <section class="card">
      <h2>Wiki</h2>
      {% if wiki_pages %}
      <ul>
        {% for p in wiki_pages %}
        <li><a href="../knowledge/wiki/{{ p }}"><code>{{ p }}</code></a></li>
        {% endfor %}
      </ul>
      {% else %}
      <p>No wiki pages yet.</p>
      {% endif %}
    </section>
  </main>
  <footer>
    CognitiveOS · local-first · this file is regenerated by <code>cogos bootstrap</code>.
  </footer>
</body>
</html>