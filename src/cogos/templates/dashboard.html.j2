<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CognitiveOS</title>
  <style>
    /* ============================================================
       Design tokens — Apple translucent material + warm light theme.
       v0.2: 引入 dark 模式占位（默认 light,localStorage 持久化）。
       Easing 单一常量贯穿全站,见 cubic-bezier(0.16, 1, 0.3, 1)。
       ============================================================ */
    :root {
      --bg:            #FAF6F0;
      --bg-elev:       #FBF4EA;
      --card:          #FFFFFF;
      --card-2:        #F4EEE4;
      --ink:           #2B1B12;
      --ink-soft:      #6B5B4E;
      --ink-faint:     #9C8B7C;
      --line:          #E4D9C9;
      --line-soft:     rgba(43,27,18,0.06);
      --accent:        #E89A3C;
      --accent-deep:   #C77F25;
      --accent-warm:   rgba(232,154,60,0.18);
      --blue:          #1B3A6E;
      --good:          #4A7C59;
      --purple:        #7C3AED;
      --cyan:          #0891B2;
      --pink:          #DB2777;
      --slate:         #64748B;

      /* Agent 专属色（每条 QA 来源不同） */
      --agent-hermes:   #1B3A6E;
      --agent-codex:    #16A34A;
      --agent-claude:   #7C3AED;

      /* iOS-style soft spring — Apple §12 + Emil "strong ease-out".
         用于所有 panel / card / viewer 的 transition. */
      --ease-spring:   cubic-bezier(0.16, 1, 0.3, 1);
      --ease-out:      cubic-bezier(0.23, 1, 0.32, 1);
      --ease-in-out:   cubic-bezier(0.77, 0, 0.175, 1);
      --ease-drawer:   cubic-bezier(0.32, 0.72, 0, 1);

      /* 动画时长 */
      --t-quick:       140ms;   /* press feedback */
      --t-base:        240ms;   /* hover / color */
      --t-sheet:       360ms;   /* viewer / panel */
      --t-stagger:     60ms;    /* vocabulary §Stagger 间隔 */

      /* 模糊半径,Apple §12: 大表面=更厚 */
      --blur-chrome:   blur(20px) saturate(180%);
      --blur-sheet:    blur(28px) saturate(180%);

      /* 阴影层级,Apple §12: 越重要越深 */
      --shadow-card:   0 6px 24px rgba(43,27,18,0.05);
      --shadow-lift:   0 14px 38px rgba(43,27,18,0.10), 0 2px 6px rgba(43,27,18,0.04);
      --shadow-sheet:  0 28px 64px -12px rgba(43,27,18,0.22), 0 8px 24px rgba(43,27,18,0.08);
    }

    /* ---------- Dark mode (v0.2 placeholder, 默认 light) ---------- */
    [data-theme="dark"] {
      --bg:           #16110D;
      --bg-elev:      #1F1812;
      --card:         #221A13;
      --card-2:       #2A2018;
      --ink:          #F5EDE3;
      --ink-soft:     #C9B9A8;
      --ink-faint:    #8A7868;
      --line:         #3A2E22;
      --line-soft:    rgba(245,237,227,0.08);
      --accent:       #F4A85A;
      --accent-deep:  #E89A3C;
      --accent-warm:  rgba(244,168,90,0.20);
      --shadow-card:  0 6px 24px rgba(0,0,0,0.35);
      --shadow-lift:  0 14px 38px rgba(0,0,0,0.45), 0 2px 6px rgba(0,0,0,0.20);
      --shadow-sheet: 0 28px 64px -12px rgba(0,0,0,0.55), 0 8px 24px rgba(0,0,0,0.30);
    }
    [data-theme="dark"] .header,
    [data-theme="dark"] .qa-viewer,
    [data-theme="dark"] .memory-strip,
    [data-theme="dark"] .identity {
      background: rgba(34,26,19,0.72);
    }

    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink); }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      line-height: 1.55;
      min-height: 100vh;
      font-size: 15px;
      /* Apple §15: optical letter-spacing — body 接近 0 */
      letter-spacing: -0.005em;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    a { color: var(--blue); text-decoration: none; }
    a:hover { text-decoration: underline; }
    a.real { background: rgba(74,124,89,0.10); border-bottom: 1px dashed var(--good); padding: 0 2px; border-radius: 2px; }
    a.placeholder { color: var(--ink-soft); border-bottom: 1px dotted var(--line); padding: 0 2px; }

    /* ============================================================
       HEADER — Apple §12 translucent chrome, content scrolls under.
       ============================================================ */
    .header {
      position: sticky; top: 0; z-index: 50;
      padding: 12px 24px 10px;
      display: flex; justify-content: space-between; align-items: center;
      gap: 20px; flex-wrap: wrap;
      background: rgba(255,255,255,0.72);
      -webkit-backdrop-filter: var(--blur-chrome);
      backdrop-filter: var(--blur-chrome);
      border-bottom: 1px solid var(--line-soft);
      /* 顶边一道高光 — Apple §12 "bright top edge" */
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);
    }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand-logo {
      width: 28px; height: 28px;
      display: inline-flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #FFF5E6 0%, #F4C77A 100%);
      border-radius: 9px;
      box-shadow: 0 2px 8px rgba(232,154,60,0.25), inset 0 1px 0 rgba(255,255,255,0.6);
      /* vocabulary §Pulse — 非常轻微的 idle 呼吸 */
      animation: pulse-idle 4s var(--ease-in-out) infinite;
    }
    @keyframes pulse-idle {
      0%, 100% { transform: scale(1); }
      50%      { transform: scale(1.04); }
    }
    .brand-logo svg { width: 18px; height: 18px; }
    .brand h1 { margin: 0; font-size: 19px; letter-spacing: -0.01em; font-weight: 600; }
    .brand h1 .en { color: var(--blue); }
    .brand h1 .zh { color: var(--accent-deep); margin-left: 8px; font-weight: 500; }

    .header-right { display: flex; align-items: center; gap: 14px; }
    .tabs { display: flex; gap: 4px; }
    .tabs button {
      border: 1px solid var(--line); background: transparent; color: var(--ink-soft);
      padding: 6px 16px; border-radius: 999px; cursor: pointer; font-size: 13px;
      transition: background var(--t-base) var(--ease-spring),
                  color     var(--t-base) var(--ease-spring),
                  border-color var(--t-base) var(--ease-spring),
                  transform var(--t-quick) var(--ease-out);
    }
    /* Emil §"Buttons must feel responsive" — press feedback */
    .tabs button:active { transform: scale(0.97); }
    .tabs button.active { background: var(--blue); border-color: var(--blue); color: #fff; }
    .tabs button:hover:not(.active) { background: var(--card-2); color: var(--ink); }

    .theme-toggle {
      width: 32px; height: 32px; border-radius: 50%;
      border: 1px solid var(--line); background: transparent;
      color: var(--ink-soft); cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      transition: background var(--t-base) var(--ease-spring),
                  color var(--t-base) var(--ease-spring),
                  transform var(--t-quick) var(--ease-out);
    }
    .theme-toggle:hover { background: var(--card-2); color: var(--ink); }
    .theme-toggle:active { transform: scale(0.92); }
    .theme-toggle svg { width: 16px; height: 16px; }

    .status {
      display: flex; gap: 14px; font-size: 12px; color: var(--ink-soft);
      padding: 5px 12px; background: var(--card-2); border-radius: 999px;
    }
    .status .dot {
      display: inline-block; width: 7px; height: 7px; border-radius: 50%;
      background: var(--good); margin-right: 5px; vertical-align: middle;
      box-shadow: 0 0 0 0 rgba(74,124,89,0.6);
      /* vocabulary §Pulse — 状态点轻微呼吸 */
      animation: status-pulse 2.4s var(--ease-in-out) infinite;
    }
    @keyframes status-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(74,124,89,0.5); }
      50%      { box-shadow: 0 0 0 6px rgba(74,124,89,0); }
    }

    /* ============================================================
       IDENTITY strip
       ============================================================ */
    .identity {
      padding: 14px 24px 16px;
      background: #FFFCF6;
      border-bottom: 1px solid var(--line-soft);
    }
    .identity .row { display: flex; gap: 24px; flex-wrap: wrap; font-size: 13px; color: var(--ink-soft); }
    .identity strong { color: var(--ink); font-weight: 600; margin-right: 6px; }
    .identity .rules { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px; }
    .identity .rules span {
      padding: 3px 10px; border-radius: 999px;
      background: var(--accent-warm); color: var(--accent-deep); font-size: 12px;
      border: 1px solid rgba(232,154,60,0.30);
      transition: transform var(--t-quick) var(--ease-out),
                  background var(--t-base) var(--ease-spring);
    }
    .identity .rules span:hover {
      transform: translateY(-1px);
      background: rgba(232,154,60,0.28);
    }

    /* ============================================================
       HERO — 大标题 / 大脑图 / 右侧详情 三段 1:2:1 (用户反馈#1).
       ============================================================ */
    .hero {
      padding: 36px 28px 12px;
      display: grid;
      grid-template-columns: 1fr 2fr 1fr;
      gap: 24px; align-items: start;
      max-width: 1500px; margin: 0 auto;
    }
    @media (max-width: 1100px) { .hero { grid-template-columns: 1fr; } }

    .hero-left {
      /* 左侧栏: 大标题 + 副标 */
      padding-top: 8px;
    }
    .hero-eyebrow {
      font-size: 11px; letter-spacing: 1.4px; text-transform: uppercase;
      color: var(--accent-deep); font-weight: 700; margin-bottom: 8px;
    }
    .hero-title {
      /* Apple §15: 大字 → 紧 tracking */
      font-size: clamp(22px, 2.2vw, 30px);
      font-weight: 700; color: var(--ink);
      letter-spacing: -0.022em;
      line-height: 1.22;
      margin: 0;
    }
    .hero-sub {
      margin-top: 12px;
      font-size: 14px; color: var(--ink-soft);
      letter-spacing: -0.005em;
      line-height: 1.55;
    }

    .hero-center {
      display: flex; flex-direction: column; align-items: center;
    }
    .hero-right {
      padding-top: 14px;
      font-size: 12.5px; color: var(--ink-soft);
      line-height: 1.55;
    }
    .hero-right .tip {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 12px 14px;
      box-shadow: var(--shadow-card);
    }
    .hero-right .tip b { color: var(--ink); display: block; margin-bottom: 4px; }

    /* ============================================================
       PAIN CARDS — hover: translateY(-4px) + 加深阴影 (用户反馈#9).
       vocabulary §Stagger — 入场按索引错开。
       ============================================================ */
    .pains {
      max-width: 1500px; margin: 18px auto 0; padding: 0 28px;
    }
    .pains-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
    }
    @media (max-width: 980px) { .pains-grid { grid-template-columns: 1fr; } }
    .pain-card {
      --i: 0;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 16px 18px;
      box-shadow: var(--shadow-card);
      /* Spring + ease-spring, 只动 transform / opacity (vocabulary §Performance) */
      transition: transform var(--t-sheet) var(--ease-spring),
                  box-shadow var(--t-sheet) var(--ease-spring),
                  border-color var(--t-base) var(--ease-spring);
      will-change: transform;
      /* 入场 stagger: 0.05s 偏移 * i */
      opacity: 0;
      transform: translateY(12px);
      animation: reveal-up 540ms var(--ease-spring) forwards;
      animation-delay: calc(var(--i) * var(--t-stagger) + 80ms);
    }
    .pains-grid .pain-card:nth-child(1) { --i: 0; }
    .pains-grid .pain-card:nth-child(2) { --i: 1; }
    .pains-grid .pain-card:nth-child(3) { --i: 2; }
    @keyframes reveal-up {
      to { opacity: 1; transform: translateY(0); }
    }
    .pain-card:hover {
      /* 用户反馈 #9: 不直接 transition, 而是 translateY + shadow 增强 */
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
      border-color: rgba(232,154,60,0.35);
    }
    .pain-emoji { font-size: 26px; margin-bottom: 6px; }
    .pain-name { font-weight: 700; color: var(--blue); font-size: 14px; margin-bottom: 4px; letter-spacing: -0.01em; }
    .pain-body { color: var(--ink-soft); font-size: 13px; }

    /* ============================================================
       MAIN DASHBOARD GRID — 大脑图 (中) + 工作记忆 (右)
       ============================================================ */
    main.dash {
      display: grid;
      grid-template-columns: minmax(360px, 1fr) minmax(420px, 1fr);
      gap: 20px;
      padding: 22px 28px 4px;
      max-width: 1500px; margin: 0 auto;
    }
    @media (max-width: 980px) { main.dash { grid-template-columns: 1fr; } }

    /* ----- Brain card ----- */
    .brain-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 16px 18px 12px;
      box-shadow: var(--shadow-card);
    }
    .brain-card .title {
      font-size: 11px; letter-spacing: 1.2px; text-transform: uppercase;
      color: var(--accent-deep); margin-bottom: 8px; font-weight: 700;
    }
    .brain-wrap {
      position: relative; width: 100%; aspect-ratio: 1 / 1; overflow: visible;
      /* 入场: 略放大 + 淡入 (Emil §"Never animate from scale(0)" — 从 0.94 起) */
      animation: brain-arrive 720ms var(--ease-spring) both;
      animation-delay: 120ms;
    }
    @keyframes brain-arrive {
      from { opacity: 0; transform: scale(0.94); }
      to   { opacity: 1; transform: scale(1); }
    }
    .brain-wrap img.brain { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    .brain-wrap svg.overlay { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }

    /* 用户反馈 #7: 引线细一点,圆点小一点 */
    .leader {
      fill: none;
      stroke-width: 0.6;
      opacity: 0.55;
      stroke: var(--ink);
      transition: stroke-width var(--t-base) var(--ease-spring),
                  opacity      var(--t-base) var(--ease-spring);
    }
    .anchor {
      opacity: 0.95;
      transition: r var(--t-base) var(--ease-spring),
                  filter var(--t-base) var(--ease-spring);
      filter: drop-shadow(0 1px 2px rgba(0,0,0,0.15));
    }
    .callout { cursor: pointer; }
    .callout text { cursor: pointer; }
    .callout .leader { pointer-events: none; }  /* leader lines are visual-only */
    .callout .anchor { cursor: pointer; }
    .callout .lbl {
      font: 700 16px/1.2 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
      fill: var(--ink); paint-order: stroke; stroke: #fff; stroke-width: 4px;
      transition: fill var(--t-base) var(--ease-spring);
    }
    .callout .anchor { r: 10; }
    /* hover — 引线变粗、圆点放大、label 着色 */
    .callout:hover .leader { stroke-width: 1.4; opacity: 1; stroke: var(--accent-deep); }
    .callout:hover .anchor { r: 12; filter: drop-shadow(0 2px 6px rgba(232,154,60,0.5)); }
    .callout:hover .lbl { fill: var(--accent-deep); }
    .callout.selected .leader { stroke-width: 1.4; opacity: 1; stroke: var(--accent-deep); }
    .callout.selected .anchor { r: 12; filter: drop-shadow(0 2px 6px rgba(232,154,60,0.5)); }
    .callout.selected .lbl { fill: var(--accent-deep); }

    /* ----- Right column ----- */
    .right-col { display: flex; flex-direction: column; gap: 16px; min-width: 0; }

    /* ============================================================
       PANEL — translucent material (Apple §12)
       ============================================================ */
    .panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 14px 16px 12px;
      box-shadow: var(--shadow-card);
    }
    .panel h2 {
      margin: 0 0 10px;
      font-size: 11px; letter-spacing: 1.2px; text-transform: uppercase;
      color: var(--accent-deep); font-weight: 700;
      display: flex; justify-content: space-between; align-items: center;
    }
    .panel h2 .count {
      background: var(--card-2); color: var(--ink-soft);
      padding: 1px 8px; border-radius: 999px; font-size: 11px;
      letter-spacing: 0; text-transform: none; font-weight: 500;
    }

    /* ============================================================
       WORKING MEMORY — 主人反复强调的更高权重 (用户反馈#2):
       暖橙底 + 左边框 4px + 更粗字。
       ============================================================ */
    .memory-strip {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 22px 24px 20px;
      box-shadow: var(--shadow-card);
      margin: 18px 28px 0;
      max-width: 1500px; margin-left: auto; margin-right: auto;
    }
    .memory-strip h2 {
      margin: 0 0 4px; font-size: 11px; letter-spacing: 1.2px;
      text-transform: uppercase; color: var(--accent-deep); font-weight: 700;
    }
    .memory-strip .empty { color: var(--ink-soft); font-size: 13px; }
    .memory-strip .body { display: none; }
    .memory-strip .body.shown { display: block; }

    .wm-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; }
    .wm-head .brain-name {
      font-size: 20px; font-weight: 700; color: var(--blue);
      letter-spacing: -0.015em;
    }
    .wm-head .sys-name {
      font-size: 14px; color: var(--accent-deep); font-weight: 600;
    }

    .wm-row { margin: 10px 0 6px; display: flex; gap: 10px; align-items: baseline; }
    .wm-row .k {
      font-size: 11px; letter-spacing: 0.8px; text-transform: uppercase;
      color: var(--accent-deep); width: 110px; flex: none; font-weight: 700;
    }
    .wm-row .v { font-size: 14px; color: var(--ink); }

    /* 「主人反复强调的」标题块 — 用户反馈 #2: 给最高权重 */
    .master-says-block {
      margin-top: 14px;
      background: var(--accent-warm);
      border-left: 4px solid var(--accent);
      border-radius: 0 10px 10px 0;
      padding: 12px 14px;
    }
    .master-says-block .master-label {
      font-size: 11px; letter-spacing: 1.0px; text-transform: uppercase;
      color: var(--accent-deep); font-weight: 700;
      margin-bottom: 6px;
      display: flex; align-items: center; gap: 6px;
    }
    .master-says-block .master-label::before {
      content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent);
    }
    .memory-list {
      list-style: none; padding: 0; margin: 0;
      display: grid; gap: 6px;
    }
    .memory-list li {
      /* 主人强调的条目: 更粗字 + 暖橙左边框 + 暖底色 */
      padding: 8px 12px;
      background: rgba(255,255,255,0.72);
      border-left: 3px solid var(--accent);
      border-radius: 0 8px 8px 0;
      font-size: 14px;        /* 比次要信息粗 */
      font-weight: 600;       /* 比次要信息粗 */
      color: var(--ink);
      line-height: 1.5;
      transition: transform var(--t-base) var(--ease-spring),
                  background var(--t-base) var(--ease-spring);
    }
    .memory-list li::before { content: "•"; color: var(--accent-deep); font-weight: 700; margin-right: 6px; }
    .memory-list li:hover { transform: translateX(2px); background: #FFFFFF; }
    .memory-list li a.mem-link {
      display: inline-block; margin-left: 8px;
      font-size: 11px; color: var(--ink-soft); font-weight: 400;
      text-decoration: underline dotted; cursor: pointer;
      transition: color var(--t-base) var(--ease-spring);
    }
    .memory-list li a.mem-link:hover { color: var(--blue); text-decoration: underline; }

    /* ============================================================
       LOWER STRIP — projects / qa / commands
       ============================================================ */
    .lower-strip {
      display: grid;
      grid-template-columns: minmax(240px, 1fr) minmax(340px, 1.4fr) minmax(220px, 1fr);
      gap: 18px;
      padding: 18px 28px 24px;
      max-width: 1500px; margin: 0 auto;
    }
    @media (max-width: 1100px) { .lower-strip { grid-template-columns: 1fr; } }

    /* ----- Project list ----- */
    .project-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
    .project-list li a {
      display: flex; justify-content: space-between; gap: 8px;
      padding: 9px 12px;
      background: var(--card-2); border: 1px solid var(--line); border-radius: 10px;
      color: var(--ink); text-decoration: none; font-size: 13.5px;
      transition: background var(--t-base) var(--ease-spring),
                  transform var(--t-quick) var(--ease-out),
                  box-shadow var(--t-base) var(--ease-spring);
    }
    .project-list li a:hover {
      background: #F0E4D2;
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(43,27,18,0.06);
      text-decoration: none;
    }
    .project-list li a:active { transform: translateY(0) scale(0.99); }
    .project-list .note { color: var(--ink-soft); font-size: 12px; }

    /* ============================================================
       QA PANEL — agent badge 着色 + hover 微物理动效 (用户反馈#3)
       ============================================================ */
    .qa-panel { max-height: 480px; overflow-y: auto; }
    .qa-group { margin-bottom: 14px; }
    .qa-group:last-child { margin-bottom: 0; }

    .qa-group-head {
      display: flex; align-items: center; gap: 8px; margin-bottom: 8px;
    }
    .qa-agent {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 12px; font-weight: 700; letter-spacing: 0.3px;
      padding: 3px 10px 3px 8px; border-radius: 999px;
      color: #fff;
      /* agent 专属色: hermes=blue / codex=green / claude_code=violet */
    }
    .qa-agent svg { width: 12px; height: 12px; opacity: 0.9; }
    .qa-agent[data-source="hermes"]     { background: var(--agent-hermes); }
    .qa-agent[data-source="codex"]      { background: var(--agent-codex); }
    .qa-agent[data-source="claude_code"]{ background: var(--agent-claude); }
    .qa-agent[data-source="default"]    { background: var(--slate); }

    .qa-count {
      font-size: 11px; color: var(--ink-soft);
      background: var(--card-2); padding: 1px 8px; border-radius: 999px;
    }

    .qa-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
    .qa-list li a {
      display: flex; justify-content: space-between; align-items: center; gap: 8px;
      padding: 8px 12px;
      border-left: 3px solid var(--accent);
      background: var(--card-2); border-radius: 0 8px 8px 0;
      color: var(--ink); text-decoration: none; font-size: 13px;
      cursor: pointer;
      /* 物理式 hover: translateY + scale + 阴影 (用户反馈#3) */
      transition: transform var(--t-base) var(--ease-spring),
                  background var(--t-base) var(--ease-spring),
                  box-shadow var(--t-base) var(--ease-spring),
                  border-left-color var(--t-base) var(--ease-spring);
    }
    .qa-list li a:hover {
      transform: translateY(-2px) scale(1.01);
      background: #FFFFFF;
      box-shadow: 0 6px 18px rgba(43,27,18,0.08);
      border-left-color: var(--accent-deep);
      text-decoration: none;
    }
    .qa-list li a:active { transform: translateY(-1px) scale(0.995); }
    .qa-list .q { font-weight: 500; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .qa-list .ts { color: var(--ink-soft); font-size: 11px; margin-left: 6px; flex: none; }
    .qa-list .ts.placeholder { font-style: italic; }

    /* ----- Tools ----- */
    .tools {
      display: grid; gap: 6px;
      font-family: ui-monospace, "JetBrains Mono", Consolas, monospace;
      font-size: 12.5px;
    }
    .tools span {
      padding: 6px 11px; background: var(--card-2);
      border: 1px solid var(--line); border-radius: 7px;
      transition: background var(--t-base) var(--ease-spring),
                  transform var(--t-quick) var(--ease-out);
    }
    .tools span:hover { background: #F0E4D2; transform: translateX(2px); }
    .tools span .label { color: var(--ink-soft); margin-right: 8px; }

    /* ============================================================
       INLINE VIEWERS — translucent material + spring entry
       (用户反馈#4 + Apple §12 + Emil §"never scale(0)")
       ============================================================ */
    .qa-viewer {
      display: none;
      margin: 12px 28px 24px;
      max-width: 1500px; margin-left: auto; margin-right: auto;
      padding: 22px 26px;
      background: rgba(255,255,255,0.72);
      -webkit-backdrop-filter: var(--blur-sheet);
      backdrop-filter: var(--blur-sheet);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: var(--shadow-sheet);
      /* spring entry — scale 0.96 起 (Emil: never 0) + opacity */
      opacity: 0;
      transform: translateY(10px) scale(0.96);
      transition: opacity var(--t-sheet) var(--ease-spring),
                  transform var(--t-sheet) var(--ease-spring);
    }
    .qa-viewer.open {
      display: block;
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    .qa-viewer .close {
      float: right; cursor: pointer;
      color: var(--ink-soft); font-size: 18px;
      background: var(--card-2); border: 0;
      width: 28px; height: 28px; border-radius: 50%;
      line-height: 1; display: inline-flex; align-items: center; justify-content: center;
      transition: background var(--t-base) var(--ease-spring),
                  color var(--t-base) var(--ease-spring),
                  transform var(--t-quick) var(--ease-out);
    }
    .qa-viewer .close:hover { background: var(--accent-warm); color: var(--accent-deep); }
    .qa-viewer .close:active { transform: scale(0.9); }

    .qa-viewer .qv-q {
      font-weight: 600; color: var(--blue); font-size: 15px;
      padding: 10px 14px;
      background: rgba(27,58,110,0.06);
      border-radius: 10px; margin: 0 0 12px;
    }
    .qa-viewer .qv-a {
      color: #4A3A2C; font-size: 14px; padding: 4px 2px;
      line-height: 1.7;
    }
    .qa-viewer .qv-a h1, .qa-viewer .qv-a h2,
    .qa-viewer .qv-a h3, .qa-viewer .qv-a h4 {
      margin: 14px 0 6px; color: var(--ink); line-height: 1.3;
    }
    .qa-viewer .qv-a h1 { font-size: 18px; }
    .qa-viewer .qv-a h2 { font-size: 16px; }
    .qa-viewer .qv-a h3 { font-size: 15px; }
    .qa-viewer .qv-a p { margin: 6px 0; }
    .qa-viewer .qv-a ul, .qa-viewer .qv-a ol { margin: 6px 0; padding-left: 22px; }
    .qa-viewer .qv-a li { margin: 3px 0; }
    .qa-viewer .qv-a code {
      background: var(--card-2); padding: 1px 6px; border-radius: 4px;
      font-size: 12.5px; font-family: ui-monospace, Consolas, monospace;
      color: var(--blue);
    }
    .qa-viewer .qv-a pre {
      background: var(--card-2); border: 1px solid var(--line);
      border-radius: 8px; padding: 10px 12px; overflow-x: auto;
      margin: 8px 0;
    }
    .qa-viewer .qv-a pre code { background: none; padding: 0; }
    .qa-viewer .qv-a blockquote {
      border-left: 3px solid var(--accent); padding: 4px 12px;
      color: var(--ink-soft); margin: 8px 0; background: var(--card-2);
      border-radius: 0 6px 6px 0;
    }
    .qa-viewer .qv-meta {
      color: var(--ink-soft); font-size: 12px; margin-bottom: 10px;
    }

    /* ============================================================
       ABOUT TAB — preserved (about-h2 spacing, brain-regions, vs box 等)
       ============================================================ */
    .about-wrap { display: none; padding: 22px 28px 40px; max-width: 900px; margin: 0 auto; }
    .about-wrap.shown { display: block; }
    .about-wrap h2 { font-size: 26px; color: var(--blue); margin: 0 0 6px; letter-spacing: -0.02em; }
    .about-wrap h2.about-h2 { font-size: 22px; color: var(--ink); margin: 32px 0 8px; padding-top: 20px; border-top: 1px solid var(--line); }
    .about-wrap .lead { color: var(--ink-soft); font-size: 15px; margin: 0 0 18px; }
    .about-wrap p { color: #4A3A2C; margin: 8px 0; }
    .about-wrap ul { color: #4A3A2C; padding-left: 22px; }
    .about-wrap li { margin: 5px 0; }
    .about-wrap .brain-regions {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 10px; margin: 12px 0;
    }
    .about-wrap .brain-regions .region {
      background: var(--card); border: 1px solid var(--line); border-radius: 10px;
      padding: 12px 14px;
    }
    .about-wrap .brain-regions .region .name { font-weight: 700; color: var(--blue); }
    .about-wrap .brain-regions .region .role { font-size: 13px; color: var(--ink-soft); margin-top: 2px; }
    .about-wrap .vs {
      display: grid; grid-template-columns: 1fr auto 1fr; gap: 14px; align-items: center;
      margin: 14px 0;
    }
    .about-wrap .vs .box {
      background: var(--card-2); border: 1px solid var(--line); border-radius: 10px;
      padding: 12px 14px; font-size: 13.5px;
    }
    .about-wrap .vs .box .box-title { font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .about-wrap .vs .vs-mid { color: var(--accent-deep); font-weight: 700; font-size: 20px; }
    .about-wrap .flow {
      background: var(--card-2); border: 1px solid var(--line); border-radius: 10px;
      padding: 12px 14px; font-family: ui-monospace, Consolas, monospace; font-size: 13px;
      margin: 8px 0; color: #4A3A2C;
    }
    .about-wrap .future-agents { display: grid; gap: 8px; margin: 10px 0; }
    .about-wrap .future-agents .agent {
      display: flex; gap: 10px; align-items: baseline;
      background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px;
    }
    .about-wrap .future-agents .agent .n { font-weight: 700; color: var(--accent-deep); }
    .about-wrap .series { list-style: none; padding: 0; margin: 10px 0; display: grid; gap: 6px; counter-reset: series; }
    .about-wrap .series li {
      counter-increment: series;
      background: var(--card); border: 1px solid var(--line); border-radius: 8px;
      padding: 9px 14px; font-size: 14px;
    }
    .about-wrap .series li::before {
      content: counter(series);
      display: inline-block; width: 22px; height: 22px; line-height: 22px;
      text-align: center; background: var(--accent); color: #fff; border-radius: 50%;
      font-size: 12px; font-weight: 700; margin-right: 10px;
    }

    /* ----- flow diagram ----- */
    .flow-diagram {
      background: var(--card); border: 1px solid var(--line);
      border-radius: 14px; padding: 22px;
      margin: 24px 0;
    }
    .flow-diagram h2 { font-size: 18px; color: var(--blue); margin: 0 0 6px; letter-spacing: -0.01em; }
    .flow-diagram p.lede { color: var(--ink-soft); font-size: 13px; margin: 0 0 16px; }
    .flow-diagram svg.flow-svg { width: 100%; height: auto; display: block; }
    .flow-diagram .step text { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
    .flow-diagram .step-label { font: 700 12px/1.2 -apple-system, sans-serif; fill: #fff; }
    .flow-diagram .step-sub { font: 500 9.5px/1.2 -apple-system, sans-serif; fill: #fff; opacity: 0.9; }
    .flow-diagram .arrow { stroke: var(--ink-soft); stroke-width: 1.5; fill: none; marker-end: url(#arrowhead); }
    .flow-diagram .arrow-label { font: 500 10px/1.2 -apple-system, sans-serif; fill: var(--ink-soft); }
    .flow-diagram .legend { margin-top: 14px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 12px; color: var(--ink-soft); }
    .flow-diagram .legend b { color: var(--ink); }

    /* ============================================================
       Reduced motion — Apple §14: 替换为 opacity crossfade
       ============================================================ */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 200ms !important;
        transition-timing-function: ease !important;
      }
      .qa-viewer { transform: none !important; }
      .pain-card { transform: none !important; opacity: 1 !important; }
    }

    /* ============================================================
       Responsive
       ============================================================ */
    @media (max-width: 700px) {
      .header { padding: 10px 16px; }
      .identity { padding: 12px 16px 14px; }
      .hero { padding: 24px 16px 8px; }
      .pains { padding: 0 16px; }
      main.dash { padding: 16px 16px 0; }
      .lower-strip { padding: 16px 16px 20px; }
      .qa-viewer { margin: 12px 16px 20px; }
    }
  </style>
</head>
<body>
  <!-- ============ HEADER: 顶导 + translucent material ============ -->
  <div class="header" role="banner">
    <div class="brand">
      <span class="brand-logo" aria-hidden="true">
        <!-- 内联 SVG 大脑 logo -->
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 5c-2 0-3.5 1.5-3.5 3.5-1 .5-1.5 1.5-1.5 2.5 0 1.2.7 2.2 1.7 2.7C4.2 14.5 4 15.3 4 16c0 1.7 1.3 3 3 3h.5c.3 1.2 1.4 2 2.7 2 1.6 0 2.8-1.2 2.8-2.8V8.2C13 6.4 11.6 5 9.8 5H8z"
                fill="#fff" opacity="0.6"/>
          <path d="M16 5c2 0 3.5 1.5 3.5 3.5 1 .5 1.5 1.5 1.5 2.5 0 1.2-.7 2.2-1.7 2.7.5.8.7 1.6.7 2.3 0 1.7-1.3 3-3 3h-.5c-.3 1.2-1.4 2-2.7 2-1.6 0-2.8-1.2-2.8-2.8V8.2C11 6.4 12.4 5 14.2 5H16z"
                fill="#C77F25" opacity="0.85"/>
          <path d="M12 8.5v9" stroke="#fff" stroke-width="0.7" opacity="0.7"/>
        </svg>
      </span>
      <h1><span class="en">CognitiveOS</span><span class="zh">认知地图</span></h1>
    </div>
    <div class="header-right">
      <div class="status"><span class="dot"></span><span data-i18n="statusOnline">operational</span></div>
      <div class="tabs">
        <button id="tab-dash" class="active" onclick="switchTab('dash')" data-i18n="tabDash">Dashboard</button>
        <button id="tab-about" onclick="switchTab('about')" data-i18n="tabAbout">About</button>
      </div>
      <button class="theme-toggle" id="theme-toggle" onclick="toggleTheme()" aria-label="toggle theme" title="切换深色/浅色">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- ============ IDENTITY ============ -->
  <div class="identity">
    <div class="row">
      <span><strong>主人:</strong><span>{{ master_name }}</span></span>
      <span><strong>版本:</strong><span>v0.1 · 本地优先</span></span>
      <span><strong>管家池:</strong><span>Hermes · Codex · Claude Code</span></span>
    </div>
    <div class="rules">
      {% for rule in rules %}<span>{{ rule }}</span>{% endfor %}
    </div>
  </div>

  <!-- ============ HERO: 三段 1:2:1 布局 (用户反馈#1) ============ -->
  <div class="hero">
    <div class="hero-left">
      <div class="hero-eyebrow">本地优先 · v0.2</div>
      <h1 class="hero-title" data-i18n="heroTitle">AI 是你的管家，CognitiveOS 保管你的认知</h1>
      <p class="hero-sub" data-i18n="heroSub">换管家、换电脑、换产品，你的偏好/项目/经验都不丢。</p>
    </div>
    <div class="hero-center"></div>
    <div class="hero-right">
      <div class="tip">
        <b>使用提示</b>
        点击大脑图上的彩色锚点，右侧会加载该脑区的工作记忆；点击「最近的问答」可内嵌查看完整对话。
      </div>
    </div>
  </div>

  <!-- ============ PAINS STRIP: 3 pain cards (用户反馈#9: hover translateY + shadow) ============ -->
  <section class="pains">
    <div class="pains-grid">
      <div class="pain-card">
        <div class="pain-emoji">😰</div>
        <div class="pain-name" data-i18n="pain1Title">想换个 AI Agent，却不敢换</div>
        <div class="pain-body" data-i18n="pain1Body">换新的 = 全部重来。你被"记忆锁定"在旧 Agent 上了。</div>
      </div>
      <div class="pain-card">
        <div class="pain-emoji">🧠</div>
        <div class="pain-name" data-i18n="pain2Title">换台电脑，等于失忆</div>
        <div class="pain-body" data-i18n="pain2Body">新电脑的 Agent 不认识你。换电脑 = 失忆，从头再来。</div>
      </div>
      <div class="pain-card">
        <div class="pain-emoji">🔒</div>
        <div class="pain-name" data-i18n="pain3Title">Agent 的记忆是"它的"，不是"你的"</div>
        <div class="pain-body" data-i18n="pain3Body">不用它了，积累就没了——换了管家，管家记得的事不是主人的事。</div>
      </div>
    </div>
  </section>

  <!-- ============ DASHBOARD TAB ============ -->
  <div id="view-dash">
    <main class="dash">
      <section class="brain-card">
        <div class="title" data-i18n="brainTitle">认知地图</div>
        <div class="brain-wrap">
          <img class="brain" src="assets/brain-source.svg" alt="" />
          <svg class="overlay" viewBox="0 0 960 960" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            {% for r in regions %}
            <g class="callout" data-region="{{ r.key }}">
              {% if r.lx < 200 %}
              <path class="leader" d="M {{ r.ax }} {{ r.ay }} C {{ r.ax - 40 }} {{ r.ay }}, {{ r.lx + 60 }} {{ r.ly }}, {{ r.lx }} {{ r.ly }}" />
              {% elif r.lx > 800 %}
              <path class="leader" d="M {{ r.ax }} {{ r.ay }} C {{ r.ax + 40 }} {{ r.ay }}, {{ r.lx - 60 }} {{ r.ly }}, {{ r.lx }} {{ r.ly }}" />
              {% else %}
              <path class="leader" d="M {{ r.ax }} {{ r.ay }} C {{ r.ax }} {{ r.ay + 50 }}, {{ r.lx }} {{ r.ly - 50 }}, {{ r.lx }} {{ r.ly }}" />
              {% endif %}
              <circle class="anchor" cx="{{ r.ax }}" cy="{{ r.ay }}" r="10" fill="{{ r.color }}" />
              {% if r.lx < 200 %}
              <text class="lbl" text-anchor="end" x="{{ r.lx }}" y="{{ r.ly - 8 }}">{{ r.label_zh }}</text>
              {% elif r.lx > 800 %}
              <text class="lbl" text-anchor="start" x="{{ r.lx }}" y="{{ r.ly - 8 }}">{{ r.label_zh }}</text>
              {% else %}
              <text class="lbl" text-anchor="middle" x="{{ r.lx }}" y="{{ r.ly - 8 }}">{{ r.label_zh }}</text>
              {% endif %}
            </g>
            {% endfor %}
          </svg>
        </div>
      </section>

      <section class="right-col">
        <div class="panel memory-panel" id="memory-panel">
          <h2 data-i18n="memoryTitle">Working memory</h2>
          <p class="empty" id="memory-empty" data-i18n="memoryEmpty">Click a region on the cognitive map to load its working memory.</p>
          <div class="body" id="memory-body"></div>
        </div>
      </section>
    </main>

    <div class="lower-strip">
      <div class="panel">
        <h2 data-i18n="projects">Active projects <span class="count">{{ projects | length }}</span></h2>
        {% if projects %}
        <ul class="project-list">
          {% for p in projects %}
          <li><a href="{{ p.path }}">
            <span>{{ p.title }}</span>
            {% if p.note %}<span class="note">{{ p.note }}</span>{% endif %}
          </a></li>
          {% endfor %}
        </ul>
        {% else %}
        <p style="color:var(--ink-soft);font-size:13px" data-i18n="projectsEmpty">No projects yet.</p>
        {% endif %}
      </div>

      <div class="panel qa-panel">
        <h2 data-i18n="qa">Recent Q&amp;A</h2>
        {% if qa_groups %}
        {% for g in qa_groups %}
        {% set g_idx = loop.index0 %}
        <div class="qa-group">
          <div class="qa-group-head">
            <span class="qa-agent" data-source="{{ g.source }}">
              {% if g.source == 'hermes' %}
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/></svg>
              {% elif g.source == 'codex' %}
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 3l-2 2v14l2 2h8l2-2V5l-2-2H8zm2 4h4v2h-4V7zm0 4h4v2h-4v-2zm0 4h4v2h-4v-2z"/></svg>
              {% elif g.source == 'claude_code' %}
              <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="3"/><path d="M12 2a10 10 0 0110 10h-3a7 7 0 00-7-7V2zM2 12A10 10 0 0112 2v3a7 7 0 00-7 7H2zm10 10A10 10 0 012 12h3a7 7 0 007 7v3zm10-10a10 10 0 01-10 10v-3a7 7 0 007-7h3z"/></svg>
              {% else %}
              <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg>
              {% endif %}
              {{ g.display }}
            </span>
            <span class="qa-count">{{ g.records | length }}</span>
          </div>
          <ul class="qa-list">
            {% for q in g.records %}
            {% set q_text = q.question | replace('\n', ' ') %}
            {% set q_text2 = q_text | replace('**', '') | replace('`', '') %}
            {% set q_short = q_text2 | truncate(70, True, '…') %}
            <li>
              <a href="javascript:void(0)" class="qa-item" data-idx="{{ loop.index0 }}"
                 data-group="{{ g_idx }}" title="{{ q.timestamp }}"
                 onclick="renderQA({{ g_idx }}, {{ loop.index0 }})">
                <span class="q">{{ q_short }}</span>
                <span class="ts">{{ q.timestamp[:10] }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
        {% else %}
        <p style="color:var(--ink-soft);font-size:13px" data-i18n="qaEmpty">No conversations yet.</p>
        {% endif %}
      </div>

      <div class="panel">
        <h2 data-i18n="tools">Commands</h2>
        <div class="tools">
          <span><span class="label" data-i18n="tool1">brief</span>cogos brief --agent hermes</span>
          <span><span class="label" data-i18n="tool2">fit</span>cogos persona fit --seed N</span>
          <span><span class="label" data-i18n="tool3">verify</span>cogos verify</span>
          <span><span class="label" data-i18n="tool4">export</span>cogos export-user --to file.tar.gz</span>
        </div>
      </div>
    </div>

    <!-- inline QA viewer (spring + translucent material) -->
    <div class="qa-viewer" id="qa-viewer">
      <button class="close" onclick="closeQA()" aria-label="close">×</button>
      <div class="qa-viewer-body" id="qa-viewer-body"></div>
    </div>

    <div class="qa-viewer" id="mem-viewer">
      <button class="close" onclick="closeMem()" aria-label="close">×</button>
      <div class="qa-viewer-body" id="mem-viewer-body"></div>
    </div>
</div>

  <!-- ============ ABOUT TAB ============ -->
  <div class="about-wrap" id="view-about">
    <div class="flow-diagram">
      <h2 data-i18n="flowTitle">🧠 大脑各部门如何协作</h2>
      <p class="lede" data-i18n="flowLede">主人发起一次提问时，7 个脑区按下面的顺序协同工作：</p>
      <svg class="flow-svg" viewBox="0 0 1100 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Cognitive flow diagram">
