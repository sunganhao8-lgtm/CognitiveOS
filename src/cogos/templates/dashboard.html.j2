    };

    let lang = (navigator.language || 'en').toLowerCase().startsWith('zh') ? 'zh' : 'en';
    let activeKey = null;

    function t(k) { return (I18N[lang] && I18N[lang][k]) || I18N.en[k] || k; }

    function setLang(next) {
      lang = next;
      document.documentElement.lang = next === 'zh' ? 'zh-CN' : 'en';
      document.getElementById('lang-en').classList.toggle('active', next === 'en');
      document.getElementById('lang-zh').classList.toggle('active', next === 'zh');
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const k = el.getAttribute('data-i18n');
        if (I18N[lang][k] !== undefined) el.textContent = t(k);
      });
      document.querySelectorAll('.callout').forEach(g => {
        const r = REGIONS.find(x => x.key === g.dataset.region);
        if (!r) return;
        const zh = next === 'zh';
        g.querySelectorAll('.lbl')[0].setAttribute('display', zh ? 'none' : 'inline');
        g.querySelectorAll('.lbl')[1].setAttribute('display', zh ? 'inline' : 'none');
      });
      if (activeKey) renderMemory(activeKey);
    }

    function switchTab(tab) {
      document.getElementById('tab-dash').classList.toggle('active', tab === 'dash');
      document.getElementById('tab-about').classList.toggle('active', tab === 'about');
      document.getElementById('view-dash').style.display = tab === 'dash' ? '' : 'none';
      document.getElementById('view-about').classList.toggle('shown', tab === 'about');
    }

    function renderMemory(key) {
      const r = REGIONS.find(x => x.key === key);
      if (!r) return;
      activeKey = key;
      const brain = lang === 'zh' ? r.brain_zh : r.brain_en;
      const sys = lang === 'zh' ? r.label_zh : r.label_en;
      const func = lang === 'zh' ? r.desc_zh : r.desc_en;
      const role = lang === 'zh' ? r.role_zh : r.role_en;
      const memItems = r.memory.map(m => {
        const title = lang === 'zh' ? m.title_zh : m.title_en;
        const link = m.path
          ? `<a href="./${m.path}" target="_blank">${m.path}</a>`
          : '';
        return `<li>${title}${link}</li>`;
      }).join('');
      document.getElementById('memory-body').innerHTML = `
        <div class="wm-head">
          <span class="brain-name">${brain}</span>
          <span class="sys-name">${sys}</span>
        </div>
        <div class="wm-row"><span class="k">${t('wmFunction')}</span><span class="v">${func}</span></div>
        <div class="wm-row"><span class="k">${t('wmRole')}</span><span class="v">${role}</span></div>
        <div class="wm-row"><span class="k">${t('masterSays')}</span></div>
        <ul class="memory-list">${memItems}</ul>
      `;
      document.getElementById('memory-body').classList.add('shown');
      document.getElementById('memory-empty').style.display = 'none';
      document.querySelectorAll('.callout').forEach(g => g.classList.toggle('selected', g.dataset.region === key));
    }

    
    function renderQA(groupIdx, recIdx) {
      const groups = {{ qa_groups_json | safe }};
      const g = groups[groupIdx];
      if (!g) return;
      const rec = g.records[recIdx];
      if (!rec) return;
      const viewer = document.getElementById('qa-viewer');
      const body = document.getElementById('qa-viewer-body');
      const source = g.display || g.source;
      body.innerHTML = `
        <div class="qv-meta">${source} · ${rec.timestamp || ''} · ${t('qaSession')} ${rec.session_id || ''}</div>
        <div class="qv-q">${mdToHtml(rec.question_full || rec.question || '')}</div>
        <div class="qv-a">${mdToHtml(rec.answer_full || rec.answer || '(no answer)')}</div>
      `;
      viewer.style.display = 'block';
      viewer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function closeQA() {
      document.getElementById('qa-viewer').style.display = 'none';
      document.getElementById('qa-viewer-body').innerHTML = '';
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
    function mdToHtml(text) {
      // Lightweight, offline Markdown renderer (no CDN, file:// safe).
      // Supports: code blocks, headings, bold/italic, inline code,
      // lists, links, blockquotes, horizontal rules, paragraphs.
      const t = String(text || '');
      let html = '';
      const lines = t.split(/\r?\n/);
      let i = 0;
      const inline = (s) => {
        let r = escapeHtml(s);
        // inline code
        r = r.replace(/`([^`]+)`/g, '<code>$1</code>');
        // bold
        r = r.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        // italic
        r = r.replace(/\*([^*]+)\*/g, '<em>$1</em>');
        // links [text](url)
        r = r.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>');
        return r;
      };
      while (i < lines.length) {
        const line = lines[i];
        // fenced code block
        if (/^```/.test(line.trim())) {
          const buf = [];
          i++;
          while (i < lines.length && !/^```/.test(lines[i].trim())) { buf.push(lines[i]); i++; }
          i++; // skip closing fence
          html += '<pre><code>' + escapeHtml(buf.join('\n')) + '</code></pre>\n';
          continue;
        }
        // headings
        const h = line.match(/^(#{1,4})\s+(.*)$/);
        if (h) {
          const level = h[1].length;
          html += '<h' + level + '>' + inline(h[2]) + '</h' + level + '>\n';
          i++;
          continue;
        }
        // horizontal rule
        if (/^\s*([-*_])\s*\1\s*\1\s*$/.test(line)) {
          html += '<hr/>\n'; i++; continue;
        }
        // unordered list block
        if (/^\s*[-*+]\s+/.test(line)) {
          html += '<ul>\n';
          while (i < lines.length && /^\s*[-*+]\s+/.test(lines[i])) {
            html += '<li>' + inline(lines[i].replace(/^\s*[-*+]\s+/, '')) + '</li>\n';
            i++;
          }
          html += '</ul>\n';
          continue;
        }
        // ordered list block
        if (/^\s*\d+\.\s+/.test(line)) {
          html += '<ol>\n';
          while (i < lines.length && /^\s*\d+\.\s+/.test(lines[i])) {
            html += '<li>' + inline(lines[i].replace(/^\s*\d+\.\s+/, '')) + '</li>\n';
            i++;
          }
          html += '</ol>\n';
          continue;
        }
        // blockquote
        if (/^\s*>\s?/.test(line)) {
          const buf = [];
          while (i < lines.length && /^\s*>\s?/.test(lines[i])) {
            buf.push(lines[i].replace(/^\s*>\s?/, ''));
            i++;
          }
          html += '<blockquote>' + inline(buf.join(' ')) + '</blockquote>\n';
          continue;
        }
        // blank line
        if (!line.trim()) { i++; continue; }
        // paragraph (merge until blank / block start)
        const buf = [line];
        i++;
        while (i < lines.length && lines[i].trim() && !/^```/.test(lines[i].trim())
               && !/^#{1,4}\s/.test(lines[i]) && !/^\s*[-*+]\s+/.test(lines[i])
               && !/^\s*\d+\.\s+/.test(lines[i]) && !/^\s*>\s?/.test(lines[i])) {
          buf.push(lines[i]); i++;
        }
        html += '<p>' + inline(buf.join(' ')) + '</p>\n';
      }
      return html;
    }



function closeMemory() {
      activeKey = null;
      document.getElementById('memory-body').classList.remove('shown');
      document.getElementById('memory-body').innerHTML = '';
      document.getElementById('memory-empty').style.display = '';
      document.querySelectorAll('.callout').forEach(g => g.classList.remove('selected'));
    }

    document.querySelectorAll('.callout').forEach(g => {
      const fire = () => renderMemory(g.dataset.region);
      g.addEventListener('click', fire);
      g.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fire(); }
      });
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
    });

    if (lang === 'zh') setLang('zh');
  </script>
</body>
</html>
