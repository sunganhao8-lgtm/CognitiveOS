<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CognitiveOS — Cognitive Map</title>
  <style>
    :root {
      --bg: #FAF6F0;
      --card: #FFFFFF;
      --card-2: #F4EEE4;
      --ink: #2B1B12;
      --ink-soft: #6B5B4E;
      --line: #E4D9C9;
      --accent: #E89A3C;
      --accent-deep: #C77F25;
      --blue: #1B3A6E;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink); }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      line-height: 1.6;
      min-height: 100vh;
    }
    header {
      padding: 18px 28px 14px;
      border-bottom: 1px solid var(--line);
      background: linear-gradient(90deg, #FFFFFF 0%, #FBF4EA 55%, #F7ECDB 100%);
      display: flex; justify-content: space-between; align-items: center;
      gap: 20px; flex-wrap: wrap;
    }
    header h1 { margin: 0; font-size: 22px; letter-spacing: 0.3px; }
    header h1 .en { color: var(--blue); }
    header h1 .zh { color: var(--accent-deep); }
    .header-right { display: flex; align-items: center; gap: 16px; }
    .lang-switch {
      display: inline-flex; border: 1px solid var(--line); border-radius: 999px;
      overflow: hidden; background: #FFF;
    }
    .lang-switch button {
      border: 0; background: transparent; padding: 6px 14px; cursor: pointer;
      font-size: 13px; color: var(--ink-soft); transition: all 140ms;
    }
    .lang-switch button.active { background: var(--blue); color: #fff; }

    main {
      display: grid;
      grid-template-columns: minmax(420px, 1.25fr) minmax(340px, 1fr);
      gap: 22px;
      padding: 22px 28px 40px;
      max-width: 1500px;
      margin: 0 auto;
    }
    @media (max-width: 960px) { main { grid-template-columns: 1fr; } }

    .map-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 8px 28px rgba(43,27,18,0.06);
    }
    .map-card h2 {
      margin: 0 0 8px;
      font-size: 12px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--accent-deep);
    }
    .brain-wrap { position: relative; width: 100%; aspect-ratio: 1 / 1; }
    .brain-wrap img.brain { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    .brain-wrap svg.overlay { position: absolute; inset: 0; width: 100%; height: 100%; }

    .leader { fill: none; stroke-width: 2.2; opacity: 0.75; }
    .anchor { opacity: 0.9; }
    .hit { fill: transparent; cursor: pointer; }
    .callout text { cursor: pointer; }
    .callout .lbl { font: 700 24px/1.2 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif; fill: var(--ink); paint-order: stroke; stroke: #fff; stroke-width: 5px; }
    .callout:hover .leader { stroke-width: 3; opacity: 1; }
    .callout:hover .lbl { fill: var(--accent-deep); }
    .callout.selected .leader { stroke-width: 3; opacity: 1; }
    .callout.selected .lbl { fill: var(--accent-deep); }

    .detail-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 22px 24px;
      box-shadow: 0 8px 28px rgba(43,27,18,0.06);
      min-height: 100%;
    }
    .detail-card h3 { margin: 0 0 6px; font-size: 22px; color: var(--blue); }
    .detail-card .desc { color: #4A3A2C; font-size: 14.5px; margin: 0 0 18px; }
    .detail-card h4 {
      margin: 14px 0 6px;
      font-size: 11px;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: var(--accent-deep);
    }
    .detail-card ul.memory-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 6px;
    }
    .detail-card ul.memory-list li a {
      display: flex; justify-content: space-between; gap: 8px;
      padding: 9px 12px;
      background: var(--card-2);
      border: 1px solid var(--line);
      border-radius: 9px;
      color: var(--ink);
      text-decoration: none;
      font-size: 13.5px;
      transition: background 130ms, border-color 130ms;
    }
    .detail-card ul.memory-list li a:hover { background: #F0E4D2; border-color: var(--accent); }
    .detail-card ul.memory-list li a .path {
      font-family: ui-monospace, "JetBrains Mono", Consolas, monospace;
      font-size: 12px; color: var(--ink-soft);
    }
    .detail-card ul.file-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
    .detail-card ul.file-list li { font-family: ui-monospace, "JetBrains Mono", Consolas, monospace; font-size: 12.5px; color: var(--ink-soft); }
    .detail-empty { color: var(--ink-soft); padding: 36px 10px; text-align: center; font-size: 14px; }
    footer { color: var(--ink-soft); font-size: 12px; padding: 12px 28px; border-top: 1px solid var(--line); }
  </style>
</head>
<body>
  <header>
    <h1><span class="en">CognitiveOS</span> <span class="zh">认知地图</span></h1>
    <div class="header-right">
      <div class="lang-switch">
        <button id="lang-en" class="active" onclick="setLang('en')">EN</button>
        <button id="lang-zh" onclick="setLang('zh')">中文</button>
      </div>
    </div>
  </header>

  <main>
    <section class="map-card">
      <h2>Cognitive Map</h2>
      <div class="brain-wrap">
        <img class="brain" src="assets/brain-source.svg" alt="Brain illustration (CC0, Wikimedia Commons)" />
        <svg class="overlay" viewBox="0 0 960 960" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          {% for r in regions %}
          <g class="callout" data-region="{{ r.key }}">
            {% if r.lx < 200 %}
            <path class="leader" d="M {{ r.ax }} {{ r.ay }} C {{ r.ax - 40 }} {{ r.ay }}, {{ r.lx + 60 }} {{ r.ly }}, {{ r.lx }} {{ r.ly }}" />
            {% elif r.lx > 800 %}
            <path class="leader" d="M {{ r.ax }} {{ r.ay }} C {{ r.ax + 40 }} {{ r.ay }}, {{ r.lx - 60 }} {{ r.ly }}, {{ r.lx }} {{ r.ly }}" />
            {% else %}
            <path class="leader" d="M {{ r.ax }} {{ r.ay }} C {{ r.ax }} {{ r.ay + 50 }}, {{ r.lx }} {{ r.ly - 50 }}, {{ r.lx }} {{ r.ly }}" />
            {% endif %}
            <circle class="anchor" cx="{{ r.ax }}" cy="{{ r.ay }}" r="14" fill="{{ r.color }}" />
            <circle class="hit" cx="{{ r.ax }}" cy="{{ r.ay }}" r="44" />
            {% if r.lx < 200 %}
            <text class="lbl" text-anchor="end" x="{{ r.lx }}" y="{{ r.ly - 8 }}">{{ r.label_en }}</text>
            <text class="lbl zh-label" text-anchor="end" x="{{ r.lx }}" y="{{ r.ly - 8 }}" display="none">{{ r.label_zh }}</text>
            {% elif r.lx > 800 %}
            <text class="lbl" text-anchor="start" x="{{ r.lx }}" y="{{ r.ly - 8 }}">{{ r.label_en }}</text>
            <text class="lbl zh-label" text-anchor="start" x="{{ r.lx }}" y="{{ r.ly - 8 }}" display="none">{{ r.label_zh }}</text>
            {% else %}
            <text class="lbl" text-anchor="middle" x="{{ r.lx }}" y="{{ r.ly - 8 }}">{{ r.label_en }}</text>
            <text class="lbl zh-label" text-anchor="middle" x="{{ r.lx }}" y="{{ r.ly - 8 }}" display="none">{{ r.label_zh }}</text>
            {% endif %}
          </g>
          {% endfor %}
        </svg>
      </div>
    </section>

    <section class="detail-card" id="detail">
      <div class="detail-empty">← Click a callout.</div>
    </section>
  </main>

  <footer>CognitiveOS · local-first · regenerated by <code>cogos bootstrap</code> · brain artwork: Human-brain-vector.svg (CC0, Wikimedia Commons)</footer>

  <script>
    const REGIONS = {{ regions_json | safe }};

    function detectLang() {
      const nav = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
      return nav.startsWith('zh') ? 'zh' : 'en';
    }

    let lang = detectLang();
    let activeKey = null;
    const detail = document.getElementById('detail');

    function t(lang, en, zh) { return lang === 'zh' ? zh : en; }
    function fileUrl(p) { return './' + p; }

    function setLang(next) {
      lang = next;
      document.documentElement.lang = next === 'zh' ? 'zh-CN' : 'en';
      document.getElementById('lang-en').classList.toggle('active', next === 'en');
      document.getElementById('lang-zh').classList.toggle('active', next === 'zh');

      document.querySelectorAll('.callout').forEach(g => {
        const r = REGIONS.find(x => x.key === g.dataset.region);
        if (!r) return;
        const zh = next === 'zh';
        g.querySelectorAll('.lbl')[0].setAttribute('display', zh ? 'none' : 'inline');
        g.querySelectorAll('.lbl')[1].setAttribute('display', zh ? 'inline' : 'none');
      });

      if (activeKey) render(activeKey);
    }

    function render(key) {
      const r = REGIONS.find(x => x.key === key);
      if (!r) return;
      activeKey = key;
      const desc = t(lang, r.desc_en, r.desc_zh);
      const fileItems = r.files.map(([l, p]) => `<li>${p}</li>`).join('');
      const memItems = r.memory.map(m => {
        const title = t(lang, m.title_en, m.title_zh);
        return `<li><a href="${fileUrl(m.path)}"><span>${title}</span><span class="path">${m.path}</span></a></li>`;
      }).join('');
      detail.innerHTML = `
        <h3 style="color:${r.color}">${t(lang, r.label_en, r.label_zh)}</h3>
        <p class="desc">${desc}</p>
        <h4>${lang === 'zh' ? '设计文件' : 'Design files'}</h4>
        <ul class="file-list">${fileItems}</ul>
        <h4>${lang === 'zh' ? '该分区记住的东西' : 'What this region remembers'}</h4>
        <ul class="memory-list">${memItems}</ul>
      `;
      document.querySelectorAll('.callout').forEach(g => g.classList.toggle('selected', g.dataset.region === key));
    }

    document.querySelectorAll('.callout').forEach(g => {
      const fire = () => render(g.dataset.region);
      g.addEventListener('click', fire);
      g.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fire(); }
      });
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
    });

    // Apply detected language immediately on load.
    if (lang === 'zh') setLang('zh');
    render('prefrontal');
  </script>
</body>
</html>